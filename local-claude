  echo "binaries: $LLAMA_DIR ($(LD_LIBRARY_PATH="$LLAMA_DIR" "$LLAMA_DIR/llama-server" --version 2>&1 | head -1 | sed 's/version: //'))"
  if llama_up; then
    props="$(curl -sf "${AUTH[@]}" "http://$LOCAL_HOST:$LOCAL_PORT/props" 2>/dev/null || echo '{}')"
    echo "server:   UP on http://$LOCAL_HOST:$LOCAL_PORT$([[ "$LOCAL_HOST" == 127.* || "$LOCAL_HOST" == localhost ]] && echo ' (this machine only)' || echo ' (reachable from the network)')"
    echo "api key:  $([[ "$(curl -s -o /dev/null -w '%{http_code}' "http://$LOCAL_HOST:$LOCAL_PORT/props")" == 401 ]] && echo 'required by the running server' || echo 'none (anyone who can reach the server can use it)')"
    echo "web page: $([[ "$(curl -s --compressed -o /dev/null -w '%{http_code}' "http://$LOCAL_HOST:$LOCAL_PORT/")" == 200 ]] && echo "on, http://$LOCAL_HOST:$LOCAL_PORT/" || echo 'off')"
    echo "model:    $(python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('model_path','?'))" <<<"$props" 2>/dev/null || echo '?')"
    echo "ctx:      $(python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('default_generation_settings',{}).get('n_ctx','?'))" <<<"$props" 2>/dev/null || echo '?')"
  else
