#!/usr/bin/env bash
# local-claude — Claude Code running entirely on this machine.
#
# Architecture:
#   Claude Code CLI (~/.local/bin/claude)
#     └─ Anthropic Messages API → http://127.0.0.1:8080  (llama.cpp llama-server)
#          └─ MoE model, split the way MoE actually wants to be split:
#               • attention, KV cache, router, shared experts → GPU
#               • routed expert weights                       → system RAM (--n-cpu-moe)
#
# Why that split: in a 35B-A3B model the experts are ~90% of the weights but only
# 8 of 256 are read per token, so VRAM spent on them sits idle. Attention and the
# KV cache are touched for every token, so they are what the GPU should hold.
# See docs/MOE-OFFLOAD.md for the measurements behind this.
#
# Usage:
#   ./local-claude [claude args...]           # interactive REPL
#   ./local-claude -p "prompt"                # non-interactive print mode
#   ./local-claude status                     # backend, model, tuning, VRAM
#   ./local-claude start                      # start the server without launching Claude
#   ./local-claude stop                       # stop the inference server
#   ./local-claude bench [--tune]             # measure tok/s; --tune picks the split and micro-batch
#   ./local-claude pull <repo> <file> [sha]   # resumable model download (slow-link safe)
#   ./local-claude models                     # list local GGUFs
#   ./local-claude init                       # scaffold hooks/CLAUDE.md in current project
#   ./local-claude attempts N "task"          # best-of-N, gated on .claude/verify.sh
#
# Env:
#   LOCAL_MODEL_FILE=~/models/x.gguf   pick a model explicitly (default: best in MODELS_DIR)
#   LOCAL_CTX=65536                    context window
#   LOCAL_NCMOE=34                     expert layers kept in RAM (default: tuned value)
#   LOCAL_THREADS=12                   CPU threads, unpinned (default: one per P-core, pinned)
#   LOCAL_PIN=0                        do not pin threads to cores
#   LOCAL_UBATCH=2048                  micro-batch (default: tuned value, else from VRAM)
#   LOCAL_LOAD_MODE=none               experts in pinned RAM: faster prefill, ~17 GB locked
#   LOCAL_MMPROJ=~/models/mmproj-F16.gguf   enable vision (auto-detected if unambiguous)
#   LOCAL_THINKING=0                   disable chain-of-thought (much faster turns)
#   LOCAL_TEMPLATE=0                   use the model's stock chat template (see docs)
#   LOCAL_BACKEND=ollama               fall back to the old ollama backend
#   LOCAL_MCP=1                        keep user MCP servers (off by default)
#   LOCAL_GLOBAL_CLAUDE_MD=1           also load ~/.claude/CLAUDE.md (skipped by default)
#   LOCAL_CLAUDE_MD=~/x.md             your instructions for local sessions
#                                      (default: ~/.local-claude/CLAUDE.md, if present)
#   LOCAL_SEARCH=0                     disable the local web-search MCP server
#   LOCAL_SEARCH_ENGINE=duckduckgo     or brave (default: brave if ~/.local-claude/brave-search.key
#                                      holds an API key, else duckduckgo)
#   LOCAL_BUILTIN_WEBFETCH=1           also allow Claude Code's own WebFetch (off by default)
#   LOCAL_BUILTIN_WEBSEARCH=1          also allow its WebSearch (off: cannot work locally)
#   LOCAL_STORAGE=separate             where sessions keep history and memory:
#                                      separate (~/.local-claude/claude), none, shared (~/.claude)
#   LOCAL_BACKGROUND_TRAFFIC=1 / LOCAL_FEEDBACK=1 / LOCAL_REMOTE=1
#                                      allow background traffic / feedback reports /
#                                      mirroring, remote control, cross-session messages
#   Any Claude Code variable or --settings key you set yourself wins over these defaults.
#   LOCAL_RULES=""                     disable small-model rule injection
#   LOCAL_WEBUI=1                      serve llama.cpp's own chat page (off by default)
#   LOCAL_API_KEY=<key>                require this key on the server; sessions send it
#   LOCAL_HOST=127.0.0.1               address the server listens on (this machine only)

set -euo pipefail

# Resolve through the symlink so the launcher works from ~/.local/bin too.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"

PREFIX="${LOCAL_CLAUDE_PREFIX:-$HOME/.local/share/local-claude}"
STATE_DIR="${LOCAL_CLAUDE_STATE:-$HOME/.local-claude}"
MODELS_DIR="${MODELS_DIR:-$HOME/models}"
LOCAL_BACKEND="${LOCAL_BACKEND:-llamacpp}"
LOCAL_HOST="${LOCAL_HOST:-127.0.0.1}"
LOCAL_PORT="${LOCAL_PORT:-8080}"
# An API key for the server, for when it listens beyond this machine. Passed to
# llama-server through the environment, not its command line, which `ps` shows
# to every user; Claude Code gets it as its auth token, and the launcher's own
# requests send it too. LLAMA_API_KEY, llama.cpp's own name, counts as well.
API_KEY="${LOCAL_API_KEY:-${LLAMA_API_KEY:-}}"
AUTH=(); [[ -n "$API_KEY" ]] && AUTH=(-H "Authorization: Bearer $API_KEY")
# The web search engine: Brave's Search API once its key is in brave-search.key,
# else DuckDuckGo, which needs none. A file rather than an environment variable,
# which every program started from the shell, cloud sessions included, could read.
BRAVE_KEY_FILE="$STATE_DIR/brave-search.key"
SEARCH_ENGINE="${LOCAL_SEARCH_ENGINE:-$([[ -s "$BRAVE_KEY_FILE" ]] && echo brave || echo duckduckgo)}"
mkdir -p "$STATE_DIR"

# install.sh writes hardware-derived defaults here. They are loaded as HWENV_*,
# not under their own names: exported as LOCAL_*, they would look exactly like a
# choice the user made — outranking values `bench --tune` measured, and passed
# on as "explicit" to every child, the tuner's own server starts included.
if [[ -f "$STATE_DIR/hardware.env" ]]; then
  while IFS='=' read -r k v; do
    [[ "$k" =~ ^[A-Z_]+$ ]] || continue
    export "HWENV_$k=$v"
  done < "$STATE_DIR/hardware.env"
fi

# llama.cpp: the installed location first, then the legacy hand-install path.
if [[ -z "${LLAMA_DIR:-}" ]]; then
  for cand in "$PREFIX/current" "$HOME/opt/llamacpp/current"; do
    [[ -x "$cand/llama-server" ]] && { LLAMA_DIR="$cand"; break; }
  done
  LLAMA_DIR="${LLAMA_DIR:-$PREFIX/current}"
fi

# ---- `init`: scaffold per-project automation --------------------------------
if [[ "${1:-}" == "init" ]]; then
  mkdir -p .claude
  if [[ -f .claude/settings.json ]]; then
    echo "SKIP: .claude/settings.json exists — merge hooks manually (see $HERE/hooks/)"
  else
    cat > .claude/settings.json <<EOF
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HERE/hooks/syntax_check.sh",
            "timeout": 15,
            "statusMessage": "Syntax check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HERE/hooks/verify_on_stop.sh",
            "timeout": 200,
            "statusMessage": "Running project verification"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python3 -m py_compile*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls*)"
    ]
  }
}
EOF
    echo "OK: .claude/settings.json (syntax-check hook, verify-on-stop hook, safe allowlist)"
  fi

  if [[ -f CLAUDE.md ]]; then
    echo "SKIP: CLAUDE.md exists"
  else
    TEST_CMD="TODO: fill in (e.g. python3 -m pytest -q)"
    { [[ -f pyproject.toml || -f pytest.ini || -d tests ]]; } && TEST_CMD="python3 -m pytest -q"
    EXTRA=""
    [[ -f Makefile ]] && EXTRA="- Makefile targets: $(grep -oE '^[a-zA-Z0-9_-]+:' Makefile | tr -d ':' | head -6 | paste -sd' ' -)"$'\n'
    [[ -f package.json ]] && EXTRA="${EXTRA}- Node project: see \"scripts\" in package.json"$'\n'
    cat > CLAUDE.md <<EOF
# Project notes for the coding agent

## Commands
- Run tests: $TEST_CMD
$EXTRA
## Rules
- Work on exactly what the task asks; no drive-by refactors.
- After code changes, always run the tests above before declaring done.
- Never commit; the user reviews and commits.
EOF
    echo "OK: CLAUDE.md starter (edit the commands/rules to fit the project)"
  fi

  if [[ -f .claude/verify.sh.example || -f .claude/verify.sh ]]; then
    echo "SKIP: verify.sh(.example) exists"
  else
    cat > .claude/verify.sh.example <<'EOF'
#!/usr/bin/env bash
# Rename to verify.sh (and chmod +x) to activate the stop-gate:
# whenever the local agent tries to finish, this runs; failures are fed
# back and it keeps working (max 2 auto-retries). Exit 0 = done allowed.
set -e
python3 -m pytest -q
EOF
    echo "OK: .claude/verify.sh.example (rename to verify.sh to enable the stop-gate)"
  fi
  exit 0
fi

# ---- `pull`: resumable model download ---------------------------------------
if [[ "${1:-}" == "pull" ]]; then
  shift
  [[ $# -ge 2 ]] || { echo "usage: local-claude pull <hf-repo> <file.gguf> [sha256]"; exit 1; }
  exec "$HERE/bin/fetch-model.sh" "$@"
fi

# ---- Model selection ---------------------------------------------------------
# Newest complete .gguf wins, but a known-good main model is preferred over the
# small plumbing-test model, and never pick up a half-downloaded *.part file.
pick_model() {
  if [[ -n "${LOCAL_MODEL_FILE:-}" ]]; then
    [[ -f "$LOCAL_MODEL_FILE" ]] && { echo "$LOCAL_MODEL_FILE"; return; }
    [[ -f "$MODELS_DIR/$LOCAL_MODEL_FILE" ]] && { echo "$MODELS_DIR/$LOCAL_MODEL_FILE"; return; }
    echo "[local-claude] LOCAL_MODEL_FILE not found: $LOCAL_MODEL_FILE" >&2
    return 1
  fi
  local m
  for pat in 'Qwen3.6-35B-A3B*.gguf' '*35B-A3B*.gguf' '*A3B*.gguf' '*.gguf'; do
    m="$(ls -t "$MODELS_DIR"/$pat 2>/dev/null | grep -v '\.part$' | grep -vi 'mmproj' | head -1 || true)"
    [[ -n "$m" ]] && { echo "$m"; return; }
  done
  return 1
}

if [[ "${1:-}" == "models" ]]; then
  echo "models in $MODELS_DIR:"
  # LC_ALL=C throughout: this machine's locale formats decimals with a comma,
  # which printf then refuses to read back.
  ls -la "$MODELS_DIR"/*.gguf 2>/dev/null \
    | LC_ALL=C awk '{printf "  %-58s %6.2f GB\n", $9, $5/1e9}' || echo "  (none)"
  for p in "$MODELS_DIR"/*.part; do
    [[ -e "$p" ]] || continue
    base="$(basename "${p%.part}")"
    total="$(grep -oE 'expected size: [0-9]+' "${p%.part}.log" 2>/dev/null | tail -1 | grep -oE '[0-9]+' || echo 0)"
    state="DOWNLOADING"
    if ! pgrep -f "fetch-model.sh .* $base" >/dev/null 2>&1; then
      # pull-after.sh holds the next download until the current one lands.
      if pgrep -f "pull-after.sh .* $base" >/dev/null 2>&1; then state="QUEUED"; else state="STALLED"; fi
    fi
    LC_ALL=C awk -v p="$p" -v h="$(stat -c%s "$p")" -v t="$total" -v st="$state" 'BEGIN {
      if (t > 0) printf "  %-58s %6.2f GB  %s %d%% of %.1f GB\n", p, h/1e9, st, h*100/t, t/1e9
      else       printf "  %-58s %6.2f GB  %s\n", p, h/1e9, st }'
    # A 20 h transfer will be interrupted sooner or later; resuming costs one command.
    [[ "$state" == "STALLED" ]] && echo "      resume: setsid nohup local-claude pull <repo> $base [sha256] </dev/null >/dev/null 2>&1 &"
  done
  exit 0
fi

# ---- llama.cpp backend -------------------------------------------------------
llama_up() { curl -sf "http://$LOCAL_HOST:$LOCAL_PORT/health" >/dev/null 2>&1; }

# Per-build caches are keyed by the name of the resolved build directory.
build_id() { basename "$(readlink -f "$LLAMA_DIR" 2>/dev/null || echo "$LLAMA_DIR")"; }

# Flags that not every build has are checked against the build's own --help
# (cached per build) before use: an unknown flag stops the server from starting.
llama_supports() {
  local help="$STATE_DIR/help.$(build_id)"
  if [[ ! -s "$help" || "$LLAMA_DIR/llama-server" -nt "$help" ]]; then
    LD_LIBRARY_PATH="$LLAMA_DIR" "$LLAMA_DIR/llama-server" --help > "$help" 2>&1 || true
  fi
  grep -q -- "$1" "$help"
}

# One thread per performance core, each pinned to its own core (see
# bin/pick-cpus.sh). Decode runs the CPU's share of the model with all threads
# in lockstep, so a thread on an efficiency core, a shared hyperthread, or a core
# something else is busy on holds up the rest. On the reference machine pinning
# is worth +13% decode, and it degrades less under background load than
# unpinned threads (docs/TUNING.md). An explicit LOCAL_THREADS, LOCAL_PIN=0, or
# an unreadable topology keeps unpinned threads. Sets THREADS, PIN_ARGS, PIN_CPUS.
pick_threads() {
  THREADS="${LOCAL_THREADS:-}"; PIN_ARGS=(); PIN_CPUS=""
  local n mask cpus
  if [[ -z "$THREADS" && "${LOCAL_PIN:-1}" != "0" ]] && llama_supports --cpu-strict \
     && read -r n mask cpus < <("$HERE/bin/pick-cpus.sh" 2>/dev/null) \
     && [[ "$n" =~ ^[0-9]+$ && "$mask" =~ ^[0-9a-f]+$ ]]; then
    THREADS="$n"; PIN_ARGS=(--cpu-mask "$mask" --cpu-strict 1); PIN_CPUS="$cpus"
  fi
  THREADS="${THREADS:-${HWENV_LOCAL_THREADS:-$(nproc --all 2>/dev/null | awk '{print int($1/2)}')}}"
}

# A machine with an integrated GPU usually enumerates it first, and it is far
# slower than the discrete card, so the discrete one is selected explicitly
# rather than left to auto-detection.
detect_device() {
  # Cache per build: device names are backend-specific (the same card is Vulkan1
  # under Vulkan and CUDA0 under CUDA), so one shared cache feeds the wrong name
  # to whichever build you switch to second.
  local cache="$STATE_DIR/device.$(build_id)"
  [[ -s "$cache" ]] && { cat "$cache"; return; }
  local dev
  dev="$(LD_LIBRARY_PATH="$LLAMA_DIR" "$LLAMA_DIR/llama-server" --list-devices 2>/dev/null \
        | awk -F: '/NVIDIA|Radeon RX|Arc|Apple/ {gsub(/ /,"",$1); print $1; exit}')"
  [[ -n "$dev" ]] && echo "$dev" > "$cache"
  echo "$dev"
}

# --n-cpu-moe N keeps the experts of the first N layers in RAM. Lower N = more
# expert weights on the GPU = faster, until VRAM overflows and it collapses.
# `local-claude bench --tune` writes the measured best value here.
# The tuned split belongs to a build, not a machine: backends differ in how much
# VRAM they need for the same model, so a value measured under one can fail to
# allocate under another.
ncmoe_cache() {
  echo "$STATE_DIR/ncmoe.$(build_id)"
}

default_ncmoe() {
  [[ -s "$(ncmoe_cache)" ]] && { cat "$(ncmoe_cache)"; return; }
  [[ -s "$STATE_DIR/ncmoe" ]] && { cat "$STATE_DIR/ncmoe"; return; }   # pre-split layout
  # Until `bench --tune` has measured this machine, keep every expert in RAM:
  # that always starts, whatever the GPU. The model's own layer count is the
  # right "all of them" value, so read it rather than assuming one.
  local n
  n="$(python3 "$HERE/bin/patch-gguf.py" "${1:-}" --show 2>/dev/null \
       | awk -F= '/\.block_count /{gsub(/ /,"",$2); print $2; exit}')"
  [[ "$n" =~ ^[0-9]+$ ]] && { echo "$n"; return; }
  echo "${LOCAL_NCMOE_FALLBACK:-99}"
}

# The micro-batch `bench --tune` chose. Each micro-batch of prompt copies the
# RAM-resident experts to the GPU once, so a bigger one means fewer copies per
# token — but its compute buffer takes VRAM from the expert layers, so it is
# tuned together with the split and stored per build next to it.
ubatch_cache() { echo "$STATE_DIR/ubatch.$(build_id)"; }

default_ubatch() {
  [[ -s "$(ubatch_cache)" ]] && { cat "$(ubatch_cache)"; return; }
  echo "${HWENV_LOCAL_UBATCH:-2048}"
}

model_expert_count() {
  python3 "$HERE/bin/patch-gguf.py" "$1" --show 2>/dev/null \
    | awk -F= '/\.expert_count /{gsub(/ /,"",$2); print $2; exit}' | grep -E '^[0-9]+$' || echo 0
}

# start_llama MODEL [UBATCH] — the second argument is only used for the retry below.
start_llama() {
  local model="$1"
  local ubatch="${2:-${LOCAL_UBATCH:-$(default_ubatch)}}"
  local VISION_NOTE=""
  local ctx="${LOCAL_CTX:-${HWENV_LOCAL_CTX:-131072}}"
  local ncmoe="${LOCAL_NCMOE:-$(default_ncmoe "$model")}"
  local dev="${LOCAL_DEVICE:-$(detect_device)}"
  pick_threads
  # Two slots, because Claude Code interleaves background calls (titles,
  # summaries) with the conversation. Sharing one slot would evict the
  # conversation's cached prefix and force a full re-prefill every turn.
  # --kv-unified makes the two share one KV pool instead of splitting it in
  # half, so a long conversation can use nearly all of LOCAL_CTX while the
  # background slot only borrows the few hundred tokens it needs. Claude Code
  # auto-compacts at 100k at the earliest, so the pool has to clear that.
  local slots="${LOCAL_SLOTS:-2}"
  local args=(
    --model "$model"
    --alias "$(basename "$model" .gguf)"
    --host "$LOCAL_HOST" --port "$LOCAL_PORT"
    --ctx-size "$ctx"
    --parallel "$slots"
    --kv-unified
    --n-gpu-layers 999            # everything that is not pinned to CPU below
    --flash-attn on
    --cache-type-k "${LOCAL_KV_TYPE:-q8_0}"
    --cache-type-v "${LOCAL_KV_TYPE:-q8_0}"
    --threads "$THREADS" "${PIN_ARGS[@]}"
    --batch-size "${LOCAL_BATCH:-$(( ubatch > 2048 ? ubatch : 2048 ))}"   # never below ubatch
    --ubatch-size "$ubatch"       # 512 (the default) costs 2.8x prefill here: each
                                  # micro-batch copies the CPU-side experts to the
                                  # GPU once, so bigger ones copy less per token
    --cache-reuse 256             # reuse KV across turns instead of re-prefilling
    --cache-ram "${LOCAL_CACHE_RAM:-2048}"  # keep evicted prefixes, but the experts
                                            # need the RAM more than the cache does
    --jinja                       # tool calling needs the model's own template
    "$([[ "${LOCAL_WEBUI:-0}" == "1" ]] && echo --webui || echo --no-webui)"   # llama.cpp's chat page
  )
  # The expert split only means something for a MoE model; a dense one has no
  # expert tensors for the flag to move.
  if [[ "$(model_expert_count "$model")" -gt 0 ]]; then
    args+=(--n-cpu-moe "$ncmoe")   # the whole trick — see docs/MOE-OFFLOAD.md
  else
    ncmoe="n/a (dense model)"
  fi
  # Claude Code sends its environment block as a *trailing* system message, and
  # Qwen's stock template raises "System message must be at the beginning." on
  # that — every request 500s. Serve a patched copy of the model's own template
  # that merges system messages instead. LOCAL_TEMPLATE=0 uses the embedded one.
  if [[ "${LOCAL_TEMPLATE:-}" != "0" ]]; then
    local tpl="${LOCAL_TEMPLATE:-$STATE_DIR/templates/$(basename "$model" .gguf).jinja}"
    if [[ ! -s "$tpl" || "$model" -nt "$tpl" ]]; then
      "$HERE/bin/make-template.sh" "$model" "$tpl" >/dev/null 2>&1 \
        || echo "[local-claude] no embedded chat template to patch; using the model's own" >&2
    fi
    [[ -s "$tpl" ]] && args+=(--chat-template-file "$tpl")
  fi
  # Qwen3.5/3.6 think by default, which is most of the latency on a local box.
  # LOCAL_THINKING=0 turns it off via the model's own template switch.
  [[ "${LOCAL_THINKING:-1}" == "0" ]] && args+=(--chat-template-kwargs '{"enable_thinking":false}')
  [[ -n "$dev" ]] && args+=(--device "$dev")
  # Vision. Qwen3.6-35B-A3B is multimodal, but the vision tower ships as a
  # separate "mmproj" file, so images only work once one is present. An explicit
  # LOCAL_MMPROJ wins; otherwise pick one up automatically if exactly one is in
  # the models directory (more than one and we cannot tell which model it belongs
  # to, so we stay out of it).
  local mmproj="${LOCAL_MMPROJ:-}"
  if [[ -z "$mmproj" ]]; then
    local found=()
    for f in "$MODELS_DIR"/mmproj*.gguf; do [[ -f "$f" ]] && found+=("$f"); done
    if [[ ${#found[@]} -eq 1 ]]; then
      mmproj="${found[0]}"
    elif [[ ${#found[@]} -gt 1 ]]; then
      echo "[local-claude] several mmproj files in $MODELS_DIR — set LOCAL_MMPROJ to choose" >&2
    fi
  fi
  if [[ -n "$mmproj" && -f "$mmproj" ]]; then
    args+=(--mmproj "$mmproj")
    # The projector wants ~1 GB of VRAM — exactly what the expert layers are
    # competing for. An image is encoded once per message, not per token, so the
    # CPU is the cheaper place for it unless you have headroom to spare.
    [[ "${LOCAL_MMPROJ_DEVICE:-cpu}" == "cpu" ]] && args+=(--no-mmproj-offload)
    VISION_NOTE=" +vision($(basename "$mmproj"))"
  fi
  # LOCAL_LOAD_MODE=none loads the RAM-resident experts into pinned memory
  # instead of memory-mapping the file, so the prompt-time copies to the GPU run
  # from pinned pages: ~7% faster prefill. The cost is ~17 GB the kernel can no
  # longer reclaim while the server runs — other work on the machine runs out of
  # memory instead of slowing the model down — so it is opt-in. llama.cpp logs a
  # warning recommending it on every start; that is expected.
  if [[ -n "${LOCAL_LOAD_MODE:-}" ]]; then
    if llama_supports --load-mode; then
      args+=(--load-mode "$LOCAL_LOAD_MODE")
    else
      echo "[local-claude] this llama.cpp build has no --load-mode; ignoring LOCAL_LOAD_MODE" >&2
    fi
  fi
  [[ -n "${LOCAL_LLAMA_ARGS:-}" ]] && args+=(${LOCAL_LLAMA_ARGS})

  echo "[local-claude] starting llama-server: $(basename "$model") ctx=$ctx (${slots} slots, shared) ncmoe=$ncmoe ubatch=$ubatch threads=$THREADS${PIN_CPUS:+ pinned to CPUs $PIN_CPUS} dev=${dev:-auto}${VISION_NOTE:-}" >&2
  local log_lines
  log_lines="$(wc -l 2>/dev/null < "$STATE_DIR/llama-server.log" || echo 0)"
  # No key: make sure an empty LLAMA_API_KEY cannot reach the server either.
  local keyenv=(-u LLAMA_API_KEY); [[ -n "$API_KEY" ]] && keyenv=(LLAMA_API_KEY="$API_KEY")
  env "${keyenv[@]}" LD_LIBRARY_PATH="$LLAMA_DIR" nohup "$LLAMA_DIR/llama-server" "${args[@]}" \
    >>"$STATE_DIR/llama-server.log" 2>&1 &
  echo $! > "$STATE_DIR/llama.pid"
  echo "$model" > "$STATE_DIR/model"
  # A 22 GB model reads from disk on first load; be patient before giving up.
  for _ in $(seq 1 "${LOCAL_START_TIMEOUT:-600}"); do
    llama_up && return 0
    kill -0 "$(cat "$STATE_DIR/llama.pid")" 2>/dev/null || break
    sleep 1
  done
  # A tuned micro-batch above 2048 only fits next to the tuned split with the
  # GPU otherwise empty. If another program holds VRAM today, or LOCAL_NCMOE was
  # lowered, start at 2048 — slower prefill — rather than not at all. An
  # explicit LOCAL_UBATCH is a choice, and fails loudly instead.
  if [[ -z "${2:-}" && -z "${LOCAL_UBATCH:-}" && "$ubatch" -gt 2048 ]] \
     && tail -n +"$(( log_lines + 1 ))" "$STATE_DIR/llama-server.log" \
        | grep -qiE 'failed to allocate|out of memory'; then
    echo "[local-claude] --ubatch-size $ubatch did not fit in VRAM; retrying at 2048" >&2
    start_llama "$model" 2048
    return
  fi
  echo "[local-claude] llama-server failed to start; last lines of $STATE_DIR/llama-server.log:" >&2
  tail -15 "$STATE_DIR/llama-server.log" >&2
  return 1
}

stop_llama() {
  local stopped=1 pid pids=()
  if [[ -f "$STATE_DIR/llama.pid" ]] && kill -0 "$(cat "$STATE_DIR/llama.pid")" 2>/dev/null; then
    pids=("$(cat "$STATE_DIR/llama.pid")")
  else
    # Deliberately not `pkill -f`: that pattern also matches the command line of
    # whatever shell invoked us, and killing the caller is a memorable bug.
    for pid in $(pgrep -f "llama-server --model" 2>/dev/null); do
      [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
      pids+=("$pid")
    done
  fi
  for pid in "${pids[@]:-}"; do
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null && stopped=0
  done
  # Wait for them to actually go. A terminating server still owns its VRAM, and
  # the next one needs several gigabytes of it — starting too soon fails with
  # "unable to allocate buffer", which looks like a tuning problem and is not.
  for pid in "${pids[@]:-}"; do
    [[ -n "$pid" ]] || continue
    for _ in $(seq 1 "${LOCAL_STOP_TIMEOUT:-60}"); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  done
  rm -f "$STATE_DIR/llama.pid" "$STATE_DIR/model"
  return $stopped
}

# ---- `stop` ------------------------------------------------------------------
if [[ "${1:-}" == "stop" ]]; then
  stop_llama && echo "llama-server stopped." || echo "llama-server not running."
  if pkill -f "ollama serve" 2>/dev/null; then echo "ollama stopped."; fi
  rm -f "$STATE_DIR/ollama.pid"
  exit 0
fi

# ---- `start`: bring the server up and exit -----------------------------------
if [[ "${1:-}" == "start" ]]; then
