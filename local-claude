# ---- `bench` -----------------------------------------------------------------
# Sweeps --n-cpu-moe and reports prefill/decode speed. --tune stores the winner.
if [[ "${1:-}" == "bench" ]]; then
  shift
  exec "$HERE/test/bench.sh" "$@"
fi

# ---- `attempts`: best-of-N wrapper — retry until verify.sh passes ------------
# Usage: local-claude attempts N "task prompt"
# Runs up to N autonomous attempts; after each, .claude/verify.sh decides.
# Failed attempts are reverted (git). Sampling temperature makes attempts differ.
if [[ "${1:-}" == "attempts" ]]; then
  shift
  N="${1:?usage: local-claude attempts N \"task prompt\"}"; shift
  TASK="${*:?usage: local-claude attempts N \"task prompt\"}"
  [[ -x .claude/verify.sh ]] || { echo "attempts mode needs an executable .claude/verify.sh (acceptance test)"; exit 1; }
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "attempts mode needs a git repo (for safe revert)"; exit 1; }
  [[ -z "$(git status --porcelain)" ]] || { echo "attempts mode needs a clean working tree (commit or stash first)"; exit 1; }
  ATTEMPT_TIMEOUT="${ATTEMPT_TIMEOUT:-900}"
  TASK="$TASK
Acceptance: the script .claude/verify.sh must exit 0 — read it first and make its checks pass."
  for i in $(seq 1 "$N"); do
    echo "[attempts] === attempt $i/$N ==="
    t0=$(date +%s)
    timeout "$ATTEMPT_TIMEOUT" "$0" --dangerously-skip-permissions -p "$TASK" < /dev/null || true
    echo "[attempts] attempt $i took $(( $(date +%s) - t0 ))s; verifying..."
    if bash .claude/verify.sh; then
      echo "[attempts] PASS on attempt $i — changes kept. Review with: git diff"
      exit 0
    fi
    echo "[attempts] attempt $i failed verification — reverting"
    git checkout -q -- . && git clean -qfd
  done
  echo "[attempts] all $N attempts failed verification; tree restored to clean state"
  exit 1
fi

# ---- Bring the backend up ----------------------------------------------------
if [[ "$LOCAL_BACKEND" == "ollama" ]]; then
  # Legacy path: ollama serves /v1/messages too, but splits MoE models by whole
  # layers, so expert weights end up in VRAM where they idle. Kept as a fallback.
  OLLAMA_BIN="${OLLAMA_BIN:-$HOME/opt/ollama/bin/ollama}"
  LOCAL_MODEL="${LOCAL_MODEL:-qwen3.5:35b}"
  export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
  export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-49152}"
  export OLLAMA_FLASH_ATTENTION=1
  export OLLAMA_KV_CACHE_TYPE="${OLLAMA_KV_CACHE_TYPE:-q8_0}"
  export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-2h}"
  export OLLAMA_MAX_LOADED_MODELS=1
  if ! curl -sf "http://$OLLAMA_HOST/api/version" >/dev/null 2>&1; then
    echo "[local-claude] starting ollama server..." >&2
    nohup "$OLLAMA_BIN" serve >>"$STATE_DIR/ollama.log" 2>&1 &
    echo $! > "$STATE_DIR/ollama.pid"
    for _ in $(seq 1 60); do curl -sf "http://$OLLAMA_HOST/api/version" >/dev/null 2>&1 && break; sleep 0.5; done
  fi
  "$OLLAMA_BIN" show "$LOCAL_MODEL" >/dev/null 2>&1 || "$OLLAMA_BIN" pull "$LOCAL_MODEL"
  BASE_URL="http://$OLLAMA_HOST"
  EFFECTIVE_CTX="$OLLAMA_CONTEXT_LENGTH"
else
  MODEL="$(pick_model)" || {
    echo "[local-claude] no model in $MODELS_DIR. Fetch one with:" >&2
    echo "  ./local-claude pull unsloth/Qwen3.6-35B-A3B-GGUF Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf" >&2
    exit 1
  }
  # Restart if a different model than the running one was requested.
  if llama_up && [[ -f "$STATE_DIR/model" ]] && [[ "$(cat "$STATE_DIR/model")" != "$MODEL" ]]; then
    echo "[local-claude] switching model → $(basename "$MODEL")" >&2
    stop_llama || true
    sleep 2
  fi
  llama_up || start_llama "$MODEL"
  LOCAL_MODEL="$(basename "$MODEL" .gguf)"
  BASE_URL="http://$LOCAL_HOST:$LOCAL_PORT"
  # Ask the server what it actually allocated rather than assuming LOCAL_CTX:
  # an already-running server may have been started with a different context,
  # and telling Claude Code a window larger than the real one means requests
  # get rejected mid-session instead of compacted.
  # A server started with a key refuses a session without it (and one started
  # without a key ignores the session's) — say so now, not as 401s mid-session.
  key_code="$(curl -s -o /dev/null -w '%{http_code}' "$BASE_URL/props")"
  if [[ "$key_code" == 401 && -z "$API_KEY" ]]; then
    echo "[local-claude] the running server requires an API key: set LOCAL_API_KEY" >&2; exit 1
  elif [[ "$key_code" == 401 ]] && [[ "$(curl -s -o /dev/null -w '%{http_code}' "${AUTH[@]}" "$BASE_URL/props")" == 401 ]]; then
    echo "[local-claude] the running server rejects this LOCAL_API_KEY" >&2; exit 1
  elif [[ "$key_code" != 401 && -n "$API_KEY" ]]; then
    echo "[local-claude] note: the running server was started without an API key; 'local-claude stop' to restart it with one" >&2
  fi
  EFFECTIVE_CTX="$(curl -sf "${AUTH[@]}" "$BASE_URL/props" 2>/dev/null \
    | python3 -c "import sys,json;print(json.load(sys.stdin).get('default_generation_settings',{}).get('n_ctx',0))" 2>/dev/null || echo 0)"
  [[ "${EFFECTIVE_CTX:-0}" -lt 8192 ]] && EFFECTIVE_CTX="${LOCAL_CTX:-${HWENV_LOCAL_CTX:-131072}}"
fi

# ---- Point Claude Code at the local backend ---------------------------------
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="${API_KEY:-local}"   # the server's key, if it has one
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL="$LOCAL_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$LOCAL_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$LOCAL_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$LOCAL_MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$LOCAL_MODEL"   # background/summarization calls
# 8192 is too low for a model that writes files: a single Write of a long document
# is one JSON string, and running out of budget mid-string truncates the tool call
# into invalid JSON ("InputValidationError: could not be parsed as JSON"). Thinking
# tokens come out of this same budget, so leave real headroom. Qwen3.6 recommends
# at least 32k of output for complex work.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="${CLAUDE_CODE_MAX_OUTPUT_TOKENS:-32768}"
# Must exceed the worst-case generation: 32k output tokens at ~30 tok/s is ~18
# minutes, and a 10-minute timeout would abort a legitimate long write.
export API_TIMEOUT_MS="${API_TIMEOUT_MS:-1800000}"

# A local model is not in Claude Code's catalog, so it assumes a 200k window and
# would let a session grow past what the server allocated before auto-compacting.
# Tell it the truth instead, minus a margin for the background slot and the reply.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-$(( EFFECTIVE_CTX - 8192 ))}"

# ---- Keep everything on this machine ----------------------------------------
# Every setting below is a default: a variable you set yourself, even to an empty
# value, is left alone.
default_env() { [[ -v $1 ]] || export "$1=$2"; }

# No background traffic to Anthropic: telemetry, error reports, update and
# installation checks, and the plugin marketplace Claude Code installs on its
# first run in a fresh folder (from downloads.claude.ai).
if [[ "${LOCAL_BACKGROUND_TRAFFIC:-0}" != "1" ]]; then
  for v in CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC DISABLE_AUTOUPDATER DISABLE_TELEMETRY \
           DISABLE_ERROR_REPORTING DISABLE_INSTALLATION_CHECKS \
           CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL; do
    default_env "$v" 1
  done
fi
# No feedback reports, which would send the session's transcript.
if [[ "${LOCAL_FEEDBACK:-0}" != "1" ]]; then
  for v in DISABLE_BUG_COMMAND DISABLE_FEEDBACK_COMMAND CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY; do
    default_env "$v" 1
  done
fi

# Where local sessions keep what Claude Code stores: transcripts (/resume), the
# up-arrow prompt history, auto-memory notes and file snapshots (/rewind).
# Under ~/.claude, a cloud session would pick all of it up on its own, so:
#   separate (default)  a folder of their own, ~/.local-claude/claude
#   none                nothing at all, in that same separate folder
#   shared              ~/.claude, like any Claude Code session
CLOUD_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
case "${LOCAL_STORAGE:=separate}" in
  separate|none)
    export CLAUDE_CONFIG_DIR="${LOCAL_CLAUDE_CONFIG_DIR:-$STATE_DIR/claude}"
    mkdir -p "$CLAUDE_CONFIG_DIR" ;;
  shared) ;;
  *) echo "[local-claude] LOCAL_STORAGE must be separate, none or shared (got: $LOCAL_STORAGE)" >&2; exit 1 ;;
esac
if [[ "$LOCAL_STORAGE" == "none" ]]; then
  default_env CLAUDE_CODE_SKIP_PROMPT_HISTORY 1        # no transcript, no prompt history
  default_env CLAUDE_CODE_DISABLE_FILE_CHECKPOINTING 1
  default_env CLAUDE_CODE_DISABLE_AUTO_MEMORY 1
fi

# Marks this session for hooks that only apply to the local stack
export LOCAL_CLAUDE=1

# Allow launching from inside another Claude Code session (e.g. for testing)
unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SSE_PORT 2>/dev/null || true

# ---- Small-model guardrails --------------------------------------------------
# Injected into the system prompt: rules that compensate for a 35B-class model
# (weak long-horizon planning, overconfident success claims). LOCAL_RULES="" disables.
DEFAULT_RULES='IMPORTANT operating rules for this small local model:
1. Restate the task as a short numbered plan before touching any file.
2. Make the smallest change that satisfies the request; never refactor or reformat code you were not asked to change.
3. After every change, verify it: run the file, the tests, or a syntax check. Never claim something works without having run it in this session.
4. If the task is ambiguous or has no clear success criterion, ask one clarifying question before starting.
5. Read only the specific files or line ranges you need; avoid broad exploration.
6. If the same error occurs twice in a row, stop and report what you tried instead of retrying blindly.
7. Write long files in pieces: create the file with the first section, then append the rest with further edits. A single Write of more than ~300 lines risks being cut off mid-call and failing.'
LOCAL_RULES="${LOCAL_RULES-$DEFAULT_RULES}"

EXTRA_ARGS=()

