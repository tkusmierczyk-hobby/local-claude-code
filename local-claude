[[ "${LOCAL_MCP:-0}" != "1" ]] && EXTRA_ARGS+=(--strict-mcp-config)

# Nothing in a local session contacts Anthropic. With telemetry, error reports
# and updates off (above), the one route left was the built-in WebFetch: before
# each fetch it asks api.anthropic.com about the domain. Both built-in web tools
# are switched off by default, and the domain check is skipped as well.
# LOCAL_BUILTIN_WEBFETCH=1 allows WebFetch again: it fetches on this machine and
# summarises with the local model, so with the check skipped it stays local.
# WebSearch is off too: Anthropic's servers run its searches, so against a
# local model it returns nothing and the model answers from memory as if it had
# searched. LOCAL_BUILTIN_WEBSEARCH=1 allows it anyway.
DISALLOW=()
[[ "${LOCAL_BUILTIN_WEBFETCH:-0}" == "1" ]] || DISALLOW+=(WebFetch)
[[ "${LOCAL_BUILTIN_WEBSEARCH:-0}" == "1" ]] || DISALLOW+=(WebSearch)
if [[ ${#DISALLOW[@]} -gt 0 ]]; then
