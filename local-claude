  esac
  md="${LOCAL_CLAUDE_MD:-$STATE_DIR/CLAUDE.md}"
  echo "claude.md: $([[ -s "$md" ]] && echo "$md ($(wc -l < "$md") lines)" || echo "none (write one at $md)");" \
       "$([[ "${LOCAL_GLOBAL_CLAUDE_MD:-0}" == 1 ]] && echo "~/.claude/CLAUDE.md also loaded" || echo "~/.claude/CLAUDE.md skipped")"
  if [[ "${LOCAL_SEARCH:-1}" == "0" ]]; then echo "search:   off"
  elif [[ "$SEARCH_ENGINE" == brave ]]; then echo "search:   Brave Search API, key in $BRAVE_KEY_FILE$([[ -s "$BRAVE_KEY_FILE" ]] || echo ' (missing!)')"
  else echo "search:   $SEARCH_ENGINE, no key (for Brave Search, put an API key in $BRAVE_KEY_FILE)"; fi
  nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader 2>/dev/null | sed 's/^/gpu:      /'
