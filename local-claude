  fi
  echo "n-cpu-moe: ${LOCAL_NCMOE:-$(default_ncmoe "$(pick_model 2>/dev/null)")}$([[ -s "$(ncmoe_cache)" || -s "$STATE_DIR/ncmoe" ]] && echo ' (tuned)' || echo ' (default — run: local-claude bench --tune)')"
  echo "device:   ${LOCAL_DEVICE:-$(detect_device)}"
  echo "ubatch:   ${LOCAL_UBATCH:-$(default_ubatch)}$([[ -s "$(ubatch_cache)" ]] && echo ' (tuned)')"
  pick_threads
  echo "threads:  $THREADS${PIN_CPUS:+, pinned to CPUs $PIN_CPUS}"
  case "${LOCAL_STORAGE:-separate}" in
    separate) echo "storage:  separate — history and memory in ${LOCAL_CLAUDE_CONFIG_DIR:-$STATE_DIR/claude}" ;;
    none)     echo "storage:  none — nothing kept" ;;
